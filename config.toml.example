# Solana-EpochRoll Configuration Template

# Mode: Tracking 'firedancer' or 'agave' requirements
validator_mode = "firedancer"

# Connection: 'local' (validator node) or 'remote' (RPC service)
rpc_type = "remote"
rpc_url = "https://api.testnet.solana.com"

# Identity: Leave empty ("") for auto-detection on the validator node
validator_identity = ""

# Timing: Poll every 30 minutes (1800 seconds)
check_interval_seconds = 1800

# Heartbeat: Force a report every X hours (0 for every check)
report_interval_hours = 8

# --- Notifications ---

[slack]
enabled = false
webhook_url = "https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

[telegram]
enabled = false
bot_token = "YOUR_BOT_TOKEN"
chat_id = "YOUR_CHAT_ID"

[discord]
enabled = false
webhook_url = "https://discord.com/api/webhooks/YOUR/WEBHOOK/URL"